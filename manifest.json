{
  "manifest_version": 3,
  "name": "UCSBPlat Helper",
  "version": "1.0",
  "description": "Scrapes GOLD and runs major progress check",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://my.sa.ucsb.edu/gold/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "UCSBPlat"
  }
}
