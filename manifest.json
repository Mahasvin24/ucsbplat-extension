{
  "manifest_version": 3,
  "name": "UCSBPlat Helper",
  "version": "1.1",
  "description": "Syncs your GOLD schedule and major progress check to UCSBPlat",
  "permissions": ["scripting", "storage", "cookies"],
  "host_permissions": [
    "https://my.sa.ucsb.edu/gold/*",
    "https://ucsbplat.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "UCSBPlat",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
