{
  "manifest_version": 3,
  "name": "UCSBPlat Helper",
  "version": "1.0",
  "description": "Scrapes GOLD and runs major progress check",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "https://my.sa.ucsb.edu/gold/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://my.sa.ucsb.edu/gold/*"],
      "js": ["content.js"]
    }
  ]
}